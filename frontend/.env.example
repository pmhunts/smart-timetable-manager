# Base URL of the backend API. Defaults to '/api' (proxied by Vite in development).
# Set this only when the API is served from a different origin in production,
# e.g. VITE_API_URL=https://api.example.com/api (the API must then allow credentials via CORS).
VITE_API_URL=/api

# Backend address used by the Vite dev-server proxy (development only).
VITE_BACKEND_URL=http://localhost:5000
