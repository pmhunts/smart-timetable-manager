# ---------- Server ----------
NODE_ENV=development
PORT=5000
# Public URL of the frontend (used for CORS and links in emails)
FRONTEND_URL=http://localhost:5173
# Comma-separated extra origins allowed by CORS
CORS_ORIGINS=http://localhost:5173
# Run cron schedulers + notification worker inside the API process.
# Set to false if you run `npm run worker` as a separate process.
RUN_BACKGROUND_JOBS=true

# ---------- Database (MySQL 8) ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_timetable_db
DB_USER=root
DB_PASSWORD=your_password
DB_DIALECT=mysql
DB_LOGGING=false

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
BCRYPT_ROUNDS=12
PASSWORD_RESET_TTL_MINUTES=30

# ---------- Queue ----------
# bullmq = persistent Redis queue (recommended); db = MySQL polling fallback (no Redis needed)
QUEUE_DRIVER=bullmq
REDIS_URL=redis://localhost:6379
NOTIFICATION_MAX_ATTEMPTS=5
# Reminders older than this (minutes) when the worker gets to them are cancelled as stale
NOTIFICATION_STALE_MINUTES=30
# How far ahead (hours) reminders are planned into the queue
PLANNING_HORIZON_HOURS=24
# How many days ahead recurring tasks are materialised
RECURRENCE_HORIZON_DAYS=7

# ---------- Email (Nodemailer / SMTP) ----------
# live = send through SMTP; mock = log to console and mark as sent (development)
EMAIL_MODE=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
# Gmail: use an App Password (Google Account > Security > App passwords)
SMTP_PASS=your_app_password
EMAIL_FROM="Smart Timetable Manager <you@gmail.com>"

# ---------- WhatsApp Cloud API (Meta) ----------
# live = call Graph API; mock = log to console and mark as sent (development)
WHATSAPP_MODE=mock
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Used by GET /api/webhooks/whatsapp verification handshake
WHATSAPP_VERIFY_TOKEN=change_me
# App secret used to verify X-Hub-Signature-256 on webhook POSTs
WHATSAPP_APP_SECRET=
# true = send approved template messages (required outside the 24h customer-service window)
WHATSAPP_USE_TEMPLATES=true
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_TEMPLATE_TASK_REMINDER=task_reminder
WHATSAPP_TEMPLATE_TASK_START=task_start
WHATSAPP_TEMPLATE_TASK_INCOMPLETE=task_incomplete
WHATSAPP_TEMPLATE_SCHEDULE_UPDATE=schedule_update
WHATSAPP_TEMPLATE_SCHEDULE_CANCELLED=schedule_cancelled
WHATSAPP_TEMPLATE_DAILY_SUMMARY=daily_summary
WHATSAPP_TEMPLATE_GENERIC=generic_notification
